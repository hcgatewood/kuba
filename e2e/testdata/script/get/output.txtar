NAMESPACE  NAME  READY  STATUS  RESTARTS  AGE
get-output  apple-1  0/2  Running  0  <age>
-- want-events.txt --
<unknown>  Warning  BackOff  pod/banana-1  Back-off restarting failed container
-- want-annotations-raw.txt --
json  {"a":1}
note  line one
line two  tabbed
-- want-annotations-raw.go.txt --
json  {"a":1}
note  line one
       line two  tabbed
-- want-labels-both.txt --
apple-1
app  apple
tier  web

apple-2
app  apple
tier  db
-- want-labels-types.txt --
pod/apple-1
app  apple
tier  web

pod/apple-2
app  apple
tier  db

pod/banana-1
app  banana
-- want-annotations-both.txt --
json  {"a":1}
note  line one\nline two\ttabbed
-- want-annotations-both.go.txt --
apple-1
json  {"a":1}
note  line one
       line two  tabbed
-- want-describe-command.txt --
kubectl describe pod banana-1
-- want-yaml-command.txt --
kubectl get pod banana-1 --output=yaml --no-headers
-- want-json-command.txt --
kubectl get pod banana-1 --output=json --no-headers
-- want-yaml-command.go.txt --
kubectl get pod banana-1 --output=yaml
-- want-json-command.go.txt --
kubectl get pod banana-1 --output=json
-- want-events-command.txt --
kubectl get events --field-selector=involvedObject.kind=Pod,involvedObject.name=banana-1 --sort-by=.metadata.creationTimestamp --no-headers
-- want-logs-command.txt --
kubectl stern banana-1 --no-follow --color=always
-- want-logs-follow-command.txt --
kubectl stern banana-1 --since=1s --color=always
-- want-logs-both-command.txt --
kubectl stern '^(apple-1|apple-2)$' --no-follow --color=always
-- want-children-command.txt --
kubectl lineage pod banana-1
-- want-parents-command.txt --
kubectl lineage --dependencies pod banana-1
-- want-pods-command.txt --
kubectl get pods --field-selector=spec.nodeName=fig-1 --all-namespaces
-- want-node-command.txt --
kubectl get pod apple-1 --output=node --no-headers --output=custom-columns=NAME:.metadata.name,NODE:.spec.nodeName
-- want-containers-command.txt --
kubectl get pods apple-1 --output=jsonpath={range .spec.containers[*]}{.name}{'\n'}{end} --no-headers
-- objects.yaml --
apiVersion: v1
kind: Node
metadata: {name: fig-1}
status:
  addresses: [{type: InternalIP, address: 10.0.0.1}]
  conditions: [{type: Ready, status: "True"}]
---
apiVersion: v1
kind: Pod
metadata:
  name: apple-1
  labels: {app: apple, tier: web}
  annotations:
    note: "line one\nline two\ttabbed"
    json: '{"a":1}'
spec:
  nodeName: fig-1
  containers: [{name: main, image: busybox}, {name: sidecar, image: envoy}]
status: {phase: Running}
---
apiVersion: v1
kind: Pod
metadata:
  name: apple-2
  labels: {app: apple, tier: db}
spec: {containers: [{name: main, image: busybox}]}
status: {phase: Running}
---
apiVersion: v1
kind: Pod
metadata:
  name: banana-1
  labels: {app: banana}
spec: {containers: [{name: main, image: busybox}]}
status: {phase: Pending}
---
apiVersion: v1
kind: Event
metadata: {name: banana-1.backoff}
involvedObject: {kind: Pod, name: banana-1}
reason: BackOff
message: Back-off restarting failed container
type: Warning
---
apiVersion: apps/v1
kind: Deployment
metadata: {name: cherry}
spec:
  selector: {matchLabels: {app: cherry}}
  template:
    metadata: {labels: {app: cherry}}
    spec: {containers: [{name: main, image: busybox}]}
