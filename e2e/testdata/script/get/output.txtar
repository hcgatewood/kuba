# Every -o value. Kuba prints names, labels, and annotations itself; the rest end in a command. -o pods lists a node's
# pods, so the script needs a server of its own.

mkcluster apple
kapply objects.yaml
kuba get pod bnana -o name
rows banana-1

# Python bug: -o=VALUE fails, since click reads the value as =VALUE.
[impl:python] ! kuba get pod bnana -o=name
[impl:python] exitcode 2
[impl:go] kuba get pod bnana -o=name
[impl:go] rows banana-1

# Go hands kubectl's own formats to kubectl. Python's -o takes only its fixed list, so they're usage errors.
[impl:python] ! kuba get pod bnana -o jsonpath={.status.phase}
[impl:python] exitcode 2
[impl:go] kuba get pod bnana -o jsonpath={.status.phase}
[impl:go] stdout '^Pending$'
[impl:python] ! kuba get pod bnana -o custom-columns=NAME:.metadata.name,PHASE:.status.phase
[impl:python] exitcode 2
[impl:go] kuba get pod bnana -o custom-columns=NAME:.metadata.name,PHASE:.status.phase
[impl:go] rows banana-1

kuba get pod bnana -o wide
cmp stdout want-wide.txt
kuba get pod apple-1 -o labels
cmp stdout want-labels.txt
# Python escapes annotation values onto one line by default. Go keeps their lines, indenting later ones to the value
# column, unless KUBA_ESCAPE_ANNOTATIONS=true.
kuba get pod apple-1 -o annotations
[impl:python] cmp stdout want-annotations.txt
[impl:go] cmp stdout want-annotations-raw.go.txt

# Several pods each get a heading.
kuba get pod aple --no-select -o labels
cmp stdout want-labels-both.txt

# Headings name namespaces only when namespaced objects span several, so a node beside one namespace's pods adds none.
# The warning for the label-less node names its type, not the TYPE argument.
# Python bug: it finds nothing across several types.
kuba get pod,node --no-select -o labels
[impl:python] ! stdout .
[impl:go] cmp stdout want-labels-types.txt
[impl:go] stderr '^Warning: No labels found for node/fig-1 in apple/-$'

# Python bug: the headings disappear when only one of the pods has any entries.
kuba get pod aple --no-select -o annotations
[impl:python] cmp stdout want-annotations-both.txt
[impl:go] cmp stdout want-annotations-both.go.txt
stderr apple-2

# KUBA_ESCAPE_ANNOTATIONS flips each implementation's default.
[impl:python] env KUBA_ESCAPE_ANNOTATIONS=false
[impl:go] env KUBA_ESCAPE_ANNOTATIONS=true
kuba get pod apple-1 -o annotations
[impl:python] cmp stdout want-annotations-raw.txt
[impl:go] cmp stdout want-annotations.txt

# Go's printed commands leave out --no-headers, which kuba adds only when it runs the command off a terminal.
kuba get pod bnana -o yaml --command
[impl:python] cmp stdout want-yaml-command.txt
[impl:go] cmp stdout want-yaml-command.go.txt
kuba get pod bnana -o json --command
[impl:python] cmp stdout want-json-command.txt
[impl:go] cmp stdout want-json-command.go.txt

[impl:go] skip 'TODO(go): the remaining kuba -o formats'
kuba get pod apple-1 -o node
cmp stdout want-node.txt
kuba get pod apple-1 -o containers
rows main sidecar
kuba get node fig -o pods
cmp stdout want-pods.txt
kuba get pod bnana -o events
cmp stdout want-events.txt

# The rest run a tool on the match. stern follows by default, so -o logs turns that off.
kuba get pod bnana -o describe
stdout '^Name:  banana-1$'
kuba get pod bnana -o logs-follow
calls kubectl-stern
! stdout ' --no-follow'
kuba get pod bnana -o logs
calls kubectl-stern
stdout ' --no-follow'
kuba get pod bnana -o children
calls kubectl-lineage
stdout '^kubectl-lineage .*banana-1$'
! stdout dependencies
kuba get pod bnana -o parents
calls kubectl-lineage
stdout '^kubectl-lineage --dependencies .*banana-1$'

# Python bug: stern reads its pod query as an unanchored regex, yet Python hands it a lone pod's bare name, so banana-1
# would also tail banana-10. Go anchors it, as Python already does for several pods.
calls kubectl-stern
[impl:python] stdout '^kubectl-stern banana-1 '
[impl:go] stdout '\^\(banana-1\)\$'

# Formats limited to one type are an error on any other. Python exits 1 for that; Go exits 2, as for any usage error.
! kuba get pod bnana -o pods
[impl:python] exitcode 1
[impl:go] exitcode 2
stderr node
! kuba get deploy cherry -o containers
[impl:python] exitcode 1
[impl:go] exitcode 2
stderr pod

# Formats limited to one object are an error when several match.
! kuba get pod aple --no-select -o events
exitcode 1
! kuba get pod aple --no-select -o children
exitcode 1
! kuba get pod aple --no-select -o parents
exitcode 1

# Python bug: -o node on anything but a pod reaches kubectl as --output=node, which kubectl rejects.
! kuba get deploy cherry -o node
[impl:python] stderr 'unable to match a printer suitable for the output format "node"'
[impl:go] exitcode 2
[impl:go] stderr pod

# Python bug: -o fx reaches kubectl as --output=fx, which kubectl rejects.
[impl:python] ! kuba get pod bnana -o fx
[impl:python] stderr 'unable to match a printer suitable for the output format "fx"'
[impl:go] kuba get pod bnana -o fx
[impl:go] calls fx
[impl:go] stdout '"name": "banana-1"'
[impl:go] kuba get pod bnana -o fx --command
[impl:go] stdout 'json \| kuba ifne fx$'

kuba get pod bnana -o describe --command
cmp stdout want-describe-command.txt
kuba get pod bnana -o events --command
cmp stdout want-events-command.txt
kuba get pod bnana -o logs --command
cmp stdout want-logs-command.txt
kuba get pod bnana -o logs-follow --command
cmp stdout want-logs-follow-command.txt
kuba get pod aple --no-select -o logs --command
cmp stdout want-logs-both-command.txt
kuba get pod bnana -o children --command
cmp stdout want-children-command.txt
kuba get pod bnana -o parents --command
cmp stdout want-parents-command.txt
kuba get node fig -o pods --command
cmp stdout want-pods-command.txt

# Python bug: the command carries --output twice.
kuba get pod apple-1 -o node --command
cmp stdout want-node-command.txt

# Python doesn't quote the jsonpath, so the command breaks when a shell runs it.
kuba get pod apple-1 -o containers --command
cmp stdout want-containers-command.txt

-- want-wide.txt --
banana-1  0/1  Pending  0  <age>  <none>  <none>  <none>  <none>
-- want-labels.txt --
app  apple
tier  web
-- want-annotations.txt --
