# Custom resources work by kind, plural, short name, or full name, and native listings show their printer columns.
# CRDs are cluster-scoped, so the script needs a server of its own.

mkcluster apple
kapply crd.yaml widgets.yaml
kuba get widget aple
cmp stdout want.txt
kuba get widgets aple
rows apple-widget
kuba get wdg aple
rows apple-widget
kuba get widgets.fruit.example.com aple
rows apple-widget
kuba get Widget aple
rows apple-widget

# A type created after discovery was cached is still found.
kapply gadget-crd.yaml gadgets.yaml
kuba get gadget aple
rows apple-gadget

-- want.txt --
apple-widget  large  3  <age>
-- crd.yaml --
apiVersion: apiextensions.k8s.io/v1
kind: CustomResourceDefinition
metadata:
  name: widgets.fruit.example.com
spec:
  group: fruit.example.com
  names: {kind: Widget, plural: widgets, singular: widget, shortNames: [wdg]}
  scope: Namespaced
  versions:
  - name: v1
    served: true
    storage: true
    schema:
      openAPIV3Schema:
        type: object
        properties:
          spec:
            type: object
            properties:
              size: {type: string}
              count: {type: integer}
    additionalPrinterColumns:
    - {name: Size, type: string, jsonPath: .spec.size}
    - {name: Count, type: integer, jsonPath: .spec.count}
    - {name: Age, type: date, jsonPath: .metadata.creationTimestamp}
-- widgets.yaml --
apiVersion: fruit.example.com/v1
kind: Widget
metadata: {name: apple-widget}
spec: {size: large, count: 3}
---
apiVersion: fruit.example.com/v1
kind: Widget
metadata: {name: banana-widget}
spec: {size: small, count: 1}
-- gadget-crd.yaml --
apiVersion: apiextensions.k8s.io/v1
kind: CustomResourceDefinition
metadata:
  name: gadgets.fruit.example.com
spec:
  group: fruit.example.com
  names: {kind: Gadget, plural: gadgets, singular: gadget}
  scope: Namespaced
  versions:
  - {name: v1, served: true, storage: true, schema: {openAPIV3Schema: {type: object}}}
-- gadgets.yaml --
apiVersion: fruit.example.com/v1
kind: Gadget
metadata: {name: apple-gadget}
