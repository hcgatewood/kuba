# --select sends the matches through fzf, and only the pick gets printed.

kapply pods.yaml
env FZF_PICK=match:apple-2
kuba get pod aple --select
rows apple-2
calls fzf
cmp stdout want-fzf.txt

-- want-fzf.txt --
fzf --ansi --multi '--prompt=Choose pod: ' --query=aple '--header=NAME  READY  STATUS  RESTARTS  AGE'
| apple-1  0/1  Running  0  <age>
| apple-2  0/1  Running  0  <age>
-- pods.yaml --
apiVersion: v1
kind: Pod
metadata: {name: apple-1}
spec: {containers: [{name: main, image: busybox}]}
status: {phase: Running}
---
apiVersion: v1
kind: Pod
metadata: {name: apple-2}
spec: {containers: [{name: main, image: busybox}]}
status: {phase: Running}
---
apiVersion: v1
kind: Pod
metadata: {name: banana-1}
spec: {containers: [{name: main, image: busybox}]}
status: {phase: Pending}
