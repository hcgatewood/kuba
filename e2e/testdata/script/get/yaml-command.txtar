# With --command, kuba prints the final kubectl command instead of running it. -o yaml names the resolved pod.

kapply pods.yaml
kuba get pod bnana -o yaml --command
cmp stdout want.txt

-- want.txt --
kubectl get pod banana-1 --output=yaml --no-headers
-- pods.yaml --
apiVersion: v1
kind: Pod
metadata: {name: apple-1}
spec: {containers: [{name: main, image: busybox}]}
---
apiVersion: v1
kind: Pod
metadata: {name: banana-1}
spec: {containers: [{name: main, image: busybox}]}
