# hostname maps a node name (any query) to its hostname label, and an exact hostname back to node names.

mkcluster apple banana
kapply -c apple nodes.yaml
kapply -c banana honey.yaml
kuba hostname fig-1
rows fig-1.example.com
kuba hostname fg1
rows fig-1.example.com
kuba hostname grape.internal
rows grape-1
! calls fzf
env FZF_PICK=match:fig-1
kuba hostname fig
rows fig-1.example.com
env FZF_PICK=

! kuba hostname fig-2
exitcode 1
stderr fig-2
! kuba hostname cherry
exitcode 1
stderr cherry

# Python's hostname has no --context, so it only ever looks in the current context. Go takes it, as every command that
# reads the API does.
[impl:python] ! kuba hostname honey --context=banana
[impl:python] exitcode 2
[impl:python] stderr 'No such option: --context'
[impl:go] kuba hostname honey --context=banana
[impl:go] rows honey-1.example.com

-- nodes.yaml --
apiVersion: v1
kind: Node
metadata:
  name: fig-1
  labels: {kubernetes.io/hostname: fig-1.example.com}
---
apiVersion: v1
kind: Node
metadata: {name: fig-2}
---
apiVersion: v1
kind: Node
metadata:
  name: grape-1
  labels: {kubernetes.io/hostname: grape.internal}
-- honey.yaml --
apiVersion: v1
kind: Node
metadata:
  name: honey-1
  labels: {kubernetes.io/hostname: honey-1.example.com}
