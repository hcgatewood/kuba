# With several kubeconfig files, kubectl saves each change where it's defined: the current context in the first file
# that sets one, and a context's namespace in the file that holds the context.

mkcluster apple banana
kapply -c banana kiwi.yaml
exec kubectl config use-context banana
env KUBECONFIG=$WORK/first.yaml:$HOME/.kube/config
kuba ctx --list
cmp stdout want-list.txt
kuba ns kiwi
current banana kiwi
kuba ctx apple
current apple $NS
cmp first.yaml want-first.yaml

env KUBECONFIG=$HOME/.kube/config
current banana kiwi

-- want-list.txt --
          apple  apple  apple  switch-kubeconfig
*  banana  banana  banana  switch-kubeconfig
-- want-first.yaml --
apiVersion: v1
clusters: null
contexts: null
current-context: apple
kind: Config
users: null
-- first.yaml --
apiVersion: v1
kind: Config
current-context: banana
-- kiwi.yaml --
apiVersion: v1
kind: Namespace
metadata: {name: kiwi}
