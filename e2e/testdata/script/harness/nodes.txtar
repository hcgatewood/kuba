# Nodes are cluster-scoped, so the script needs a server of its own. Node labels, taints, addresses, and conditions
# all round-trip.

mkcluster apple
kapply nodes.yaml
exec kubectl get nodes -o wide --no-headers
stdout '^fig +Ready +worker +\S+ +v1.37.0 +10.0.0.7 +<none> '
stdout '^grape +NotReady +<none> '
exec kubectl get node grape -o 'jsonpath={.spec.taints[0].key}={.spec.taints[0].value}:{.spec.taints[0].effect}'
stdout '^dedicated=gpu:NoSchedule$'

-- nodes.yaml --
apiVersion: v1
kind: Node
metadata:
  name: fig
  labels: {node-role.kubernetes.io/worker: "", topology.kubernetes.io/zone: us-east-1a}
status:
  addresses: [{type: InternalIP, address: 10.0.0.7}, {type: Hostname, address: fig.internal}]
  conditions: [{type: Ready, status: "True"}]
  nodeInfo: {kubeletVersion: v1.37.0, machineID: "", systemUUID: "", bootID: "", kernelVersion: "", osImage: "",
    containerRuntimeVersion: "", kubeProxyVersion: "", operatingSystem: linux, architecture: arm64}
---
apiVersion: v1
kind: Node
metadata:
  name: grape
spec:
  taints: [{key: dedicated, value: gpu, effect: NoSchedule}]
status:
  conditions: [{type: Ready, status: "False"}]
