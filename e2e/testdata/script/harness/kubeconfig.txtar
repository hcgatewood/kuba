# Each namespaced script gets its own HOME and kubeconfig: one context, apple, defaulting to the script's namespace.

exec sh -c 'test "$HOME" = "$WORK/.home" && test "$KUBECONFIG" = "$HOME/.kube/config"'
exec kubectl config current-context
stdout '^apple$'
exec kubectl config view --minify -o 'jsonpath={..namespace}'
stdout '^harness-kubeconfig$'
exec kubectl get namespace $NS -o name
stdout '^namespace/harness-kubeconfig$'
current apple harness-kubeconfig

# current merges every file in KUBECONFIG, as kubectl does; a context naming no namespace has none.
env KUBECONFIG=$WORK/first.yaml:$KUBECONFIG
current banana ''
current banana
env KUBECONFIG=$HOME/.kube/config

# Server addresses in normalized output become the name of the first context on that server.
ptyexec kubectl config view --minify -o 'jsonpath={.clusters[0].cluster.server}'
stdout '^https://<apple>/$'

-- first.yaml --
apiVersion: v1
kind: Config
current-context: banana
contexts:
- name: banana
  context: {cluster: apple, user: apple}
